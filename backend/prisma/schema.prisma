generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  idusuario                 String               @id @db.Uuid
  nombres                   String               @db.VarChar
  apellidos                 String               @db.VarChar
  correo                    String               @unique @db.VarChar
  passwordHash              String?              @map("password_hash") @db.VarChar
  tipoUsuario               String               @default("cliente") @map("tipo_usuario") @db.VarChar
  emailVerified             Boolean              @default(false) @map("email_verified")
  provider                  String               @default("email") @db.VarChar
  providerId                String?              @map("provider_id") @db.VarChar
  tiempoRegistrado          DateTime             @default(now()) @map("tiempo_registrado") @db.Timestamptz(6)
  tiempoDuracionInscripcion String               @default("30 days") @map("tiempo_duracion_inscripcion") @db.VarChar
  bloqueadoHasta            DateTime?            @map("bloqueado_hasta") @db.Timestamptz(6)
  intentosFallidos          Int                  @default(0) @map("intentos_fallidos")
  entrenamientos            Entrenamiento[]
  passwordResetTokens       PasswordResetToken[]
  refreshTokens             RefreshToken[]
  rutinas                   Rutina[]
  seriesEntrenamiento       SerieEntrenamiento[]
  verificationCodes         VerificationCode[]

  @@map("usuarios")
}

model Ejercicio {
  id                  BigInt               @id @default(autoincrement())
  grupoSlug           String               @map("grupo_slug")
  grupoNombre         String               @map("grupo_nombre")
  nombre              String
  slug                String
  equipo              String?
  musculoPrincipal    String?              @map("musculo_principal")
  descripcion         String?
  consejo             String?
  creadoEn            DateTime             @default(now()) @map("creado_en") @db.Timestamptz(6)
  imagenUrl           String?              @map("imagen_url")
  videoUrl            String?              @map("video_url")
  rutinaEjercicios    RutinaEjercicio[]
  seriesEntrenamiento SerieEntrenamiento[]

  @@unique([grupoSlug, slug])
  @@map("ejercicios")
}

model Entrenamiento {
  id                  String               @id @db.Uuid
  usuarioId           String               @map("usuario_id") @db.Uuid
  fecha               DateTime             @default(now()) @db.Date
  notas               String?
  creadoEn            DateTime             @default(now()) @map("creado_en") @db.Timestamptz(6)
  usuario             Usuario              @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)
  seriesEntrenamiento SerieEntrenamiento[]

  @@map("entrenamientos")
}

model Rutina {
  id               String            @id @db.Uuid
  usuarioId        String            @map("usuario_id") @db.Uuid
  nombre           String
  diaEtiqueta      String?           @map("dia_etiqueta")
  creadoEn         DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)
  rutinaEjercicios RutinaEjercicio[]
  usuario          Usuario           @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@map("rutinas")
}

model RutinaEjercicio {
  id          BigInt    @id @default(autoincrement())
  rutinaId    String    @map("rutina_id") @db.Uuid
  ejercicioId BigInt    @map("ejercicio_id")
  orden       Int
  creadoEn    DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  ejercicio   Ejercicio @relation(fields: [ejercicioId], references: [id])
  rutina      Rutina    @relation(fields: [rutinaId], references: [id], onDelete: Cascade)

  @@unique([rutinaId, orden])
  @@map("rutina_ejercicios")
}

model SerieEntrenamiento {
  id              String        @id @db.Uuid
  entrenamientoId String        @map("entrenamiento_id") @db.Uuid
  ejercicioId     BigInt        @map("ejercicio_id")
  usuarioId       String        @map("usuario_id") @db.Uuid
  numeroSerie     Int           @map("numero_serie")
  repeticiones    Int
  pesoKg          Decimal?      @map("peso_kg") @db.Decimal
  creadoEn        DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  ejercicio       Ejercicio     @relation(fields: [ejercicioId], references: [id])
  entrenamiento   Entrenamiento @relation(fields: [entrenamientoId], references: [id], onDelete: Cascade)
  usuario         Usuario       @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@map("series_entrenamiento")
}

model VerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  codeHash  String   @map("code_hash") @db.VarChar
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  used      Boolean  @default(false)
  intentos  Int      @default(0)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  usuario   Usuario  @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@index([usuarioId])
  @@map("verification_codes")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  used      Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  usuario   Usuario  @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@index([usuarioId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revoked   Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  usuario   Usuario  @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}
