generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  idusuario                 String               @id @db.Uuid
  nombres                   String               @db.VarChar
  apellidos                 String               @db.VarChar
  correo                    String               @unique @db.VarChar
  passwordHash              String?              @map("password_hash") @db.VarChar
  tipoUsuario               String               @default("cliente") @map("tipo_usuario") @db.VarChar
  emailVerified             Boolean              @default(false) @map("email_verified")
  provider                  String               @default("email") @db.VarChar
  providerId                String?              @map("provider_id") @db.VarChar
  tiempoRegistrado          DateTime             @default(now()) @map("tiempo_registrado") @db.Timestamptz(6)
  tiempoDuracionInscripcion String               @default("30 days") @map("tiempo_duracion_inscripcion") @db.VarChar
  bloqueadoHasta            DateTime?            @map("bloqueado_hasta") @db.Timestamptz(6)
  intentosFallidos          Int                  @default(0) @map("intentos_fallidos")

  nutricion                  NutricionPerfil?
  referenciasNutricion       NutricionReferencia[]
  registrosNutricion         NutricionRegistro[]
  favoritosNutricion         NutricionFavorito[]
  entrenamientos            Entrenamiento[]
  passwordResetTokens       PasswordResetToken[]
  refreshTokens             RefreshToken[]
  rutinas                   Rutina[]
  seriesEntrenamiento       SerieEntrenamiento[]
  verificationCodes         VerificationCode[]
  resenas                   Resena[]
  votosUtilesResenas        VotoUtilResena[]
  denunciasPrivadas        DenunciaResenaPrivada[]
  decisionesResenas        DecisionModeracionResena[]
  respuestasResenaCreadas    RespuestaResena[]     @relation("RespuestaResenaCreador")
  respuestasResenaEditadas   RespuestaResena[]     @relation("RespuestaResenaEditor")
  respuestasResenaRetiradas  RespuestaResena[]     @relation("RespuestaResenaRetiro")
  metricasDiarias           MetricaDiaria[]
  adminSedes                AdminSede[]
  pagosIntentos             PagoIntento[]
  // Sede a la que pertenece un cliente (una sola) y vínculos que asignó.
  miembroSede               MiembroSede?         @relation("MiembroSedeUsuario")
  miembrosAsignados         MiembroSede[]        @relation("MiembroSedeAsignador")
  // Cambios de rol o de sede que recibió o que hizo esta cuenta.
  auditoriaRoles            AuditoriaRol[]       @relation("AuditoriaRolUsuario")
  auditoriaAcciones         AuditoriaRol[]       @relation("AuditoriaRolActor")

  @@map("usuarios")
}

model Ejercicio {
  id                  BigInt               @id @default(autoincrement())
  grupoSlug           String               @map("grupo_slug")
  grupoNombre         String               @map("grupo_nombre")
  nombre              String
  slug                String
  equipo              String?
  musculoPrincipal    String?              @map("musculo_principal")
  descripcion         String?
  consejo             String?
  creadoEn            DateTime             @default(now()) @map("creado_en") @db.Timestamptz(6)
  imagenUrl           String?              @map("imagen_url")
  videoUrl            String?              @map("video_url")

  rutinaEjercicios    RutinaEjercicio[]
  seriesEntrenamiento SerieEntrenamiento[]

  @@unique([grupoSlug, slug])
  @@map("ejercicios")
}

model Entrenamiento {
  id                  String               @id @db.Uuid
  usuarioId           String               @map("usuario_id") @db.Uuid
  fecha               DateTime             @default(now()) @db.Date
  notas               String?
  creadoEn            DateTime             @default(now()) @map("creado_en") @db.Timestamptz(6)

  nombre              String?
  estado              String               @default("finalizado")
  iniciadoEn          DateTime?            @map("iniciado_en") @db.Timestamptz(6)
  finalizadoEn        DateTime?            @map("finalizado_en") @db.Timestamptz(6)
  revision            Int                  @default(0)
  sesion              Json?
  rutinaOrigen        Json?                @map("rutina_origen")
  catalogoHistorico   Json?                @map("catalogo_historico")
  actualizadoEn      DateTime?             @map("actualizado_en") @db.Timestamptz(6)

  usuario             Usuario              @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)
  seriesEntrenamiento SerieEntrenamiento[]

  @@index([usuarioId, estado, fecha, creadoEn])
  @@map("entrenamientos")
}

model Rutina {
  id               String            @id @db.Uuid
  usuarioId        String            @map("usuario_id") @db.Uuid
  nombre           String
  diaEtiqueta      String?           @map("dia_etiqueta")
  creadoEn         DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)

  descripcion      String?
  objetivo         String?
  notas            String?
  dias             Int[]             @default([])
  archivada        Boolean           @default(false)
  actualizadoEn    DateTime?         @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  rutinaEjercicios RutinaEjercicio[]
  usuario          Usuario           @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@index([usuarioId, archivada])
  @@map("rutinas")
}

model RutinaEjercicio {
  id          BigInt    @id @default(autoincrement())
  rutinaId    String    @map("rutina_id") @db.Uuid
  ejercicioId BigInt    @map("ejercicio_id")
  orden       Int
  tipo        String?
  series      Int?
  repeticiones Int?
  descanso    Int?
  repeticionesMax Int? @map("repeticiones_max")
  pesoKg          Float? @map("peso_kg")
  asistenciaKg    Float? @map("asistencia_kg")
  duracionSeg     Int? @map("duracion_seg")
  distanciaKm     Float? @map("distancia_km")
  notas           String?
  creadoEn    DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  ejercicio   Ejercicio @relation(fields: [ejercicioId], references: [id])
  rutina      Rutina    @relation(fields: [rutinaId], references: [id], onDelete: Cascade)

  @@unique([rutinaId, orden])
  @@map("rutina_ejercicios")
}

model SerieEntrenamiento {
  id              String        @id @db.Uuid
  entrenamientoId String        @map("entrenamiento_id") @db.Uuid
  ejercicioId     BigInt        @map("ejercicio_id")
  usuarioId       String        @map("usuario_id") @db.Uuid
  numeroSerie     Int           @map("numero_serie")
  repeticiones    Int?
  pesoKg          Decimal?      @map("peso_kg") @db.Decimal
  tipo            String?
  duracionSeg     Int?          @map("duracion_seg")
  distanciaKm     Decimal?      @map("distancia_km") @db.Decimal
  asistenciaKg    Decimal?      @map("asistencia_kg") @db.Decimal
  creadoEn        DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)

  ejercicio       Ejercicio     @relation(fields: [ejercicioId], references: [id])
  entrenamiento   Entrenamiento @relation(fields: [entrenamientoId], references: [id], onDelete: Cascade)
  usuario         Usuario       @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@index([usuarioId, ejercicioId])
  @@index([entrenamientoId])
  @@map("series_entrenamiento")
}

model VerificationCode {
  id        String   @id @default(uuid(7)) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  codeHash  String   @map("code_hash") @db.VarChar
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  used      Boolean  @default(false)
  intentos  Int      @default(0)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario   Usuario  @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@index([usuarioId])
  @@map("verification_codes")
}

model PasswordResetToken {
  id        String   @id @default(uuid(7)) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  used      Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario   Usuario  @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@index([usuarioId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid(7)) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revoked   Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario   Usuario  @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

model Resena {
  id           String   @id @default(uuid(7)) @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  gymSlug      String   @map("gym_slug") @db.VarChar
  calificacion Int
  comentario   String   @db.Text
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario   Usuario         @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)
  respuesta RespuestaResena?
  votosUtiles VotoUtilResena[]
  visibilidad VisibilidadResena @default(VISIBLE)
  revision Int @default(1)
  denuncias DenunciaResena[]
  denunciasPrivadas DenunciaResenaPrivada[]
  decisiones DecisionModeracionResena[]

  @@index([usuarioId])
  @@index([gymSlug, creadoEn])
  @@index([visibilidad, gymSlug, creadoEn])
  @@map("resenas")
}

enum VisibilidadResena {
  VISIBLE
  OCULTA
}

enum MotivoDenunciaResena {
  ACOSO
  SPAM
  DATOS_PERSONALES
  FRAUDE
  OTRO
}

enum EstadoDenunciaResena {
  PENDIENTE
  DERIVADA
  RESUELTA
}

enum AccionModeracionResena {
  DERIVAR
  RESOLVER
  OCULTAR
  RESTAURAR
}

enum MotivoModeracionResena {
  ACOSO
  SPAM
  DATOS_PERSONALES
  FRAUDE
  SIN_INFRACCION
  CONTENIDO_CORREGIDO
  REQUIERE_REVISION
}

model DenunciaResena {
  id String @id @default(uuid(7)) @db.Uuid
  resenaId String? @map("resena_id") @db.Uuid
  gymSlug String @map("gym_slug") @db.VarChar(64)
  motivo MotivoDenunciaResena
  estado EstadoDenunciaResena @default(PENDIENTE)
  revision Int
  prioritaria Boolean @default(false)
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  revisarEn DateTime @map("revisar_en") @db.Timestamptz(6)
  resueltoEn DateTime? @map("resuelto_en") @db.Timestamptz(6)
  eliminarEn DateTime? @map("eliminar_en") @db.Timestamptz(6)
  resena Resena? @relation(fields: [resenaId], references: [id], onDelete: SetNull)
  datosPrivados DenunciaResenaPrivada?
  decisiones DecisionModeracionResena[]

  @@index([gymSlug, estado, creadoEn])
  @@index([resenaId])
  @@index([estado, revisarEn])
  @@index([eliminarEn])
  @@map("denuncias_resenas")
}

model DenunciaResenaPrivada {
  denunciaId String @id @map("denuncia_id") @db.Uuid
  resenaId String @map("resena_id") @db.Uuid
  denuncianteId String @map("denunciante_id") @db.Uuid
  descripcion String? @db.VarChar(500)
  vencerEn DateTime @map("vencer_en") @db.Timestamptz(6)
  denuncia DenunciaResena @relation(fields: [denunciaId], references: [id], onDelete: Cascade)
  resena Resena @relation(fields: [resenaId], references: [id], onDelete: Cascade)
  denunciante Usuario @relation(fields: [denuncianteId], references: [idusuario], onDelete: Cascade)

  @@unique([resenaId, denuncianteId])
  @@index([denuncianteId])
  @@index([vencerEn])
  @@map("denuncias_resenas_privadas")
}

model DecisionModeracionResena {
  id String @id @default(uuid(7)) @db.Uuid
  denunciaId String? @map("denuncia_id") @db.Uuid
  resenaId String? @map("resena_id") @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  gymSlug String @map("gym_slug") @db.VarChar(64)
  accion AccionModeracionResena
  motivo MotivoModeracionResena
  anterior VisibilidadResena?
  posterior VisibilidadResena?
  estado EstadoDenunciaResena?
  revision Int?
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  eliminarEn DateTime? @map("eliminar_en") @db.Timestamptz(6)
  denuncia DenunciaResena? @relation(fields: [denunciaId], references: [id], onDelete: Cascade)
  resena Resena? @relation(fields: [resenaId], references: [id], onDelete: SetNull)
  actor Usuario? @relation(fields: [actorId], references: [idusuario], onDelete: SetNull)

  @@index([denunciaId, creadoEn])
  @@index([resenaId, creadoEn])
  @@index([actorId])
  @@index([eliminarEn])
  @@map("decisiones_moderacion_resenas")
}

model VotoUtilResena {
  resenaId  String   @map("resena_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  resena  Resena  @relation(fields: [resenaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@id([resenaId, usuarioId])
  @@index([usuarioId])
  @@map("votos_utiles_resenas")
}

model RespuestaResena {
  resenaId         String    @id @map("resena_id") @db.Uuid
  texto            String    @db.Text
  creadoEn         DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  creadoPorId      String?   @map("creado_por_id") @db.Uuid
  actualizadoPorId String?   @map("actualizado_por_id") @db.Uuid
  eliminadoEn      DateTime? @map("eliminado_en") @db.Timestamptz(6)
  eliminadoPorId   String?   @map("eliminado_por_id") @db.Uuid

  resena      Resena   @relation(fields: [resenaId], references: [id], onDelete: Cascade)
  creador     Usuario? @relation("RespuestaResenaCreador", fields: [creadoPorId], references: [idusuario], onDelete: SetNull)
  editor      Usuario? @relation("RespuestaResenaEditor", fields: [actualizadoPorId], references: [idusuario], onDelete: SetNull)
  retiradoPor Usuario? @relation("RespuestaResenaRetiro", fields: [eliminadoPorId], references: [idusuario], onDelete: SetNull)

  @@index([creadoPorId])
  @@index([actualizadoPorId])
  @@index([eliminadoPorId])
  @@map("respuestas_resenas")
}

model MetricaDiaria {
  id                      String   @id @default(uuid(7)) @db.Uuid
  usuarioId               String   @map("usuario_id") @db.Uuid
  fecha                   DateTime @default(now()) @db.Timestamptz(6)
  diaLocal                DateTime? @map("dia_local") @db.Date
  pesoActualKg            Float?   @map("peso_actual_kg")
  vasosAgua               Int      @default(0) @map("vasos_agua")
  entrenamientoCompletado Boolean  @default(false) @map("entrenamiento_completado")

  usuario                 Usuario  @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@map("metricas_diarias")
}

// Sedes que administra cada usuario con rol "admin".
// Es la fuente verificada del backend para autorizar acciones sobre una sede
// (por ejemplo, pagar su suscripción).
model AdminSede {
  id        String   @id @default(uuid(7)) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  gymSlug   String   @map("gym_slug") @db.VarChar(64)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@unique([usuarioId, gymSlug])
  @@index([gymSlug])
  @@map("admin_sedes")
}

// Intento de pago iniciado en una pasarela (por ahora Wompi).
// - plan "suscripcion_sede": titular = la sede (gymSlug); usuarioId = admin que paga.
// - plan "suscripcion_particular": titular = usuarioId; gymSlug = null.
// El estado arranca en PENDIENTE y lo actualiza el webhook de Wompi.
model PagoIntento {
  id              String   @id @default(uuid(7)) @db.Uuid
  referencia      String   @unique @db.VarChar(64)
  proveedor       String   @default("wompi") @db.VarChar(20)
  plan            String   @db.VarChar(40)
  periodo         String   @default("mensual") @db.VarChar(20)
  usuarioId       String   @map("usuario_id") @db.Uuid
  gymSlug         String?  @map("gym_slug") @db.VarChar(64)
  // Precio de referencia en centavos USD y tasa USD→COP aplicados al crear
  // el intento. Son null en intentos creados con importes fijos en COP.
  precioUsdCentavos Int?     @map("precio_usd_centavos")
  tasaUsdCop        Decimal? @map("tasa_usd_cop") @db.Decimal(12, 4)
  // Importe final cobrado; nunca se recalcula.
  montoEnCentavos Int      @map("monto_en_centavos")
  moneda          String   @default("COP") @db.VarChar(3)
  // PENDIENTE | APROBADO | RECHAZADO | ANULADO | ERROR. Lo actualiza el
  // webhook de Wompi tras verificar la transacción con la API.
  estado          String   @default("PENDIENTE") @db.VarChar(20)
  // Transacción de Wompi asociada y marca de tiempo del último evento
  // aplicado (descarta eventos antiguos).
  wompiTransaccionId String?   @unique @map("wompi_transaccion_id") @db.VarChar(64)
  wompiEventoEn      DateTime? @map("wompi_evento_en") @db.Timestamptz(6)
  creadoEn        DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn   DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  // Restrict: un registro de pago no debe desaparecer al borrar un usuario.
  usuario Usuario @relation(fields: [usuarioId], references: [idusuario], onDelete: Restrict)

  @@index([usuarioId])
  @@index([gymSlug])
  @@map("pagos_intentos")
}

// Sede a la que pertenece un cliente. Es la fuente del servidor para la
// pertenencia (reemplaza ?gym= como origen de permisos). Cada cliente
// pertenece a una sola sede (usuario_id único). La asignan el admin de la
// sede o un super_admin; al desvincular, la cuenta vuelve a usuario_particular.
model MiembroSede {
  id          String   @id @default(uuid(7)) @db.Uuid
  usuarioId   String   @unique @map("usuario_id") @db.Uuid
  gymSlug     String   @map("gym_slug") @db.VarChar(64)
  // Cuenta que hizo la vinculación (null si esa cuenta ya no existe).
  asignadoPor String?  @map("asignado_por") @db.Uuid
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario   Usuario  @relation("MiembroSedeUsuario", fields: [usuarioId], references: [idusuario], onDelete: Cascade)
  asignador Usuario? @relation("MiembroSedeAsignador", fields: [asignadoPor], references: [idusuario], onDelete: SetNull)

  @@index([gymSlug])
  @@map("miembros_sede")
}

// Registro de solo inserción de cada cambio de rol o de sede:
// - accion: vincular_cliente | desvincular_cliente | asignar_admin | asignar_super_admin
// - origen: "api" (panel, con actor) o "cli" (script del servidor, actor null)
// Restrict en usuario_id: el registro no debe desaparecer al borrar la cuenta.
model AuditoriaRol {
  id          String   @id @default(uuid(7)) @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  accion      String   @db.VarChar(40)
  rolAnterior String   @map("rol_anterior") @db.VarChar(20)
  rolNuevo    String   @map("rol_nuevo") @db.VarChar(20)
  gymSlugs    String[] @map("gym_slugs") @db.VarChar(64)
  origen      String   @db.VarChar(10)
  motivo      String?
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario  @relation("AuditoriaRolUsuario", fields: [usuarioId], references: [idusuario], onDelete: Restrict)
  actor   Usuario? @relation("AuditoriaRolActor", fields: [actorId], references: [idusuario], onDelete: SetNull)

  @@index([usuarioId])
  @@index([creadoEn])
  @@map("auditoria_roles")
}

model AuditoriaReporte {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  solicitudId  String   @map("solicitud_id") @db.Uuid
  // Identidad opaca retenida aunque se elimine la cuenta.
  actorId      String   @map("actor_id") @db.Uuid
  tipoReporte  String   @map("tipo_reporte") @db.VarChar(20)
  formato      String   @db.VarChar(3)
  alcance      String?  @db.VarChar(12)
  sedeSlug     String?  @map("sede_slug") @db.VarChar(64)
  ocurridoEn   DateTime @map("ocurrido_en") @db.Timestamptz(6)
  evento       String   @db.VarChar(24)
  resultado    String   @db.VarChar(32)

  @@unique([solicitudId, evento])
  @@index([actorId, ocurridoEn])
  @@index([ocurridoEn])
  @@map("auditoria_reportes")
}

model NutricionPerfil {
  usuarioId          String   @id @map("usuario_id") @db.Uuid
  birthYear          Int      @map("birth_year")
  activity           String
  goal               String
  preference         String
  allergens          String[]
  needsProfessional  Boolean  @map("needs_professional")
  tracking           Boolean  @default(true)
  zone               String
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz
  usuario            Usuario  @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@map("nutricion_perfiles")
}

model NutricionReferencia {
  id          String   @id @default(uuid(7)) @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  day         DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  goal        String
  weight      Float?
  minimum     Int?
  maximum     Int?
  method      String
  usuario     Usuario  @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@index([usuarioId, day, createdAt, id])
  @@map("nutricion_referencias")
}

model NutricionRegistro {
  id           String   @id @default(uuid(7)) @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  foodId       Int      @map("food_id")
  snapshot     Json
  quantity     Float
  unit         String
  grams        Float
  protein      Float
  meal         String?
  day          DateTime @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  usuario      Usuario  @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@index([usuarioId, day, createdAt])
  @@map("nutricion_registros")
}

model NutricionFavorito {
  usuarioId   String   @map("usuario_id") @db.Uuid
  foodId      Int      @map("food_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  usuario     Usuario  @relation(fields: [usuarioId], references: [idusuario], onDelete: Cascade)

  @@id([usuarioId, foodId])
  @@map("nutricion_favoritos")
}
