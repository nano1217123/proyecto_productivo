# Puerto en el que escucha el servidor
PORT=4000

# Origen permitido por CORS (obligatorio en producción)
CLIENT_ORIGIN=http://localhost:3000

# Saltos de proxy de confianza: "1", "false" o un texto como "loopback"
TRUST_PROXY=1


# JWT
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Neon (base de datos)
DATABASE_URL=
DIRECT_URL=

RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev


FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/oauth/google/callback

# Cloudinary (subida de imágenes). Obligatorias: sin ellas el backend no arranca.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pagos · Wompi (solo Sandbox en este paso). Llaves en:
# https://comercios.wompi.co → Desarrolladores → llaves de prueba.
# El secreto de integridad NUNCA debe llegar al frontend.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
# Webhook (POST /api/pagos/wompi/webhook). Sin WOMPI_EVENTS_SECRET el webhook
# rechaza todos los eventos (503). La llave privada se usa solo en el backend
# para verificar cada transacción con la API de Wompi antes de actualizar el
# pago; sin ella el webhook también responde 503.
WOMPI_EVENTS_SECRET=
WOMPI_PRIVATE_KEY=
# Opcionales (valores por defecto):
# WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
# WOMPI_REDIRECT_URL=http://localhost:3000/dashboard/pagos/resultado
# WOMPI_API_URL=https://sandbox.wompi.co/v1

# Tasa USD -> COP SOLO PARA SANDBOX (número positivo, hasta 4 decimales).
# El backend calcula el importe: precio mensual en USD x tasa.
# Con 4000: admin 150 USD = $600.000 COP; usuario_particular 10 USD = $40.000 COP.
# Si falta o es inválida, el checkout responde 503 y no crea el intento.
# La tasa de producción y su actualización están pendientes.
USD_COP_TASA=4000

# reCAPTCHA v3 para el inicio de sesión y el registro
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
