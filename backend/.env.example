# Puerto en el que escucha el servidor
PORT=4000

# Origen permitido por CORS (obligatorio en producción)
CLIENT_ORIGIN=http://localhost:3000

# Saltos de proxy de confianza: "1", "false" o un texto como "loopback"
TRUST_PROXY=1

# Supabase: Project Settings > Data API (URL) y Project Settings > API Keys > Secret key
SUPABASE_URL=
SUPABASE_SECRET_KEY=