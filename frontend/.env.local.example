# URL del backend propio (Express + Neon)
NEXT_PUBLIC_API_URL=http://localhost:4000

# JWT_SECRET: debe coincidir EXACTAMENTE con el del backend.
# Se usa solo en el middleware de Next.js (servidor), nunca en el navegador.
JWT_SECRET=

# (Legacy) Supabase: se eliminará cuando el frontend termine la migración.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
